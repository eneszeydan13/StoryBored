generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  color        String        @default("#3B82F6") // Default avatar / identity color
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  ownedBoards     Board[]       @relation("BoardOwner")
  memberships     BoardMember[]
  assignedTickets Ticket[]      @relation("TicketAssignee")
  createdTickets  Ticket[]      @relation("TicketCreator")
}

model Board {
  id          String        @id @default(uuid())
  title       String
  description String?
  inviteCode  String        @unique @default(uuid())
  ownerId     String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner   User          @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members BoardMember[]
  tickets Ticket[]
}

model BoardMember {
  id       String   @id @default(uuid())
  boardId  String
  userId   String
  role     String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  joinedAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model Ticket {
  id          String   @id @default(uuid())
  title       String
  description String?
  state       String   @default("STORY") // STORY, TODO, IN_PROGRESS, COMPLETED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  color       String   @default("yellow") // yellow, pink, cyan, green, purple, orange
  tags        String   @default("") // comma separated string
  storyPoints Int?
  order       Int      @default(0)
  boardId     String
  creatorId   String?
  assigneeId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  creator  User?  @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignee User?  @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}
